#!/usr/bin/env bash
#
# Bootstrap the blog for local development. Safe to re-run at any time.
#
#   bin/setup
#
set -euo pipefail

cd "$(dirname "$0")/.."

expected_ruby="$(tr -d '[:space:]' < .ruby-version)"

info()  { printf '\033[1;34m==>\033[0m %s\n' "$1"; }
fail()  { printf '\033[1;31mError:\033[0m %s\n' "$1" >&2; exit 1; }

# --- Ruby -------------------------------------------------------------------
# rbenv only picks up .ruby-version if its shims are on PATH and `rbenv init`
# has run. Without that the shell falls back to whatever the global version is,
# which is the failure mode this script exists to catch.
if command -v rbenv >/dev/null 2>&1; then
  if ! rbenv versions --bare | grep -qx "$expected_ruby"; then
    fail "Ruby $expected_ruby is not installed. Run: rbenv install $expected_ruby"
  fi
  eval "$(rbenv init - bash)"
  rbenv rehash
fi

command -v ruby >/dev/null 2>&1 || fail "No ruby on PATH."

actual_ruby="$(ruby -e 'print RUBY_VERSION')"
if [ "$actual_ruby" != "$expected_ruby" ]; then
  fail "Ruby $expected_ruby expected, got $actual_ruby.
If you use rbenv, make sure 'eval \"\$(rbenv init - bash)\"' is in your shell profile."
fi

info "Ruby $actual_ruby"

# --- Bundler ----------------------------------------------------------------
# Gemfile.lock pins a bundler version that is usually newer than the one
# shipped with the Ruby build, so install it up front rather than letting
# `bundle install` fail on a fresh machine.
bundler_version="$(awk '/^BUNDLED WITH$/{getline; gsub(/[[:space:]]/,""); print}' Gemfile.lock)"

if [ -n "$bundler_version" ] && ! gem list -i bundler -v "$bundler_version" >/dev/null 2>&1; then
  info "Installing bundler $bundler_version"
  gem install bundler -v "$bundler_version" --no-document
fi

# --- Gems -------------------------------------------------------------------
# Vendored so the project is self-contained and never fights another project's
# gems. vendor/ and .bundle/ are gitignored.
info "Installing gems into vendor/bundle"
bundle config set --local path vendor/bundle
bundle install

# --- Node -------------------------------------------------------------------
command -v npm >/dev/null 2>&1 || fail "No npm on PATH. Install Node 22 or newer."

node_major="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$node_major" -lt 22 ]; then
  printf '\033[1;33mWarning:\033[0m Node %s found; CI builds on 22.\n' "$(node -v)"
fi

info "Installing npm packages"
if [ -f package-lock.json ]; then
  npm ci
else
  npm install
fi

info "Building JavaScript bundle"
npm run build:js

cat <<'DONE'

Setup complete. To run the site:

  bin/serve                    # http://localhost:4000, with livereload

DONE
