# Pairs with .gitattributes: git enforces LF in the repo, this keeps editors
# from reintroducing CRLF or stray trailing whitespace in the first place.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Gemfile]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{markdown,md}]
indent_size = 4

[Makefile]
indent_style = tab
